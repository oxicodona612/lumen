<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="lumen_black">#FF000000</color>
    <color name="lumen_ink">#FF15121F</color>

    <style name="Theme.Lumen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lumen_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/lumen_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/lumen_ink</item>
    </style>
</resources>
